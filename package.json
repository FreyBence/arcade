{
  "name": "mobile-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:database && concurrently --kill-others --names server,app \"npm:dev:server\" \"npm:dev:app\"",
    "dev:database": "docker compose up -d --wait database",
    "dev:server": "npm run build:server && node dist-server/server.js",
    "dev:app": "wait-on tcp:127.0.0.1:4173 && vite --configLoader runner",
    "build": "tsc -b && npm run build:web && npm run build:server",
    "build:web": "vite build --configLoader runner",
    "build:server": "vite build --ssr src/server/server.ts --outDir dist-server --configLoader runner",
    "start": "node dist-server/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "preview": "npm run start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx src/server/auth/bootstrap/runAdminBootstrap.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vitejs/plugin-react": "latest",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "phaser": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
