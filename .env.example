# Public Vite build-time configuration. Do not put secrets in VITE_ variables.
VITE_APP_NAME=Mobile Arcade
VITE_PHASER_WIDTH=960
VITE_PHASER_HEIGHT=540
VITE_PHASER_BACKGROUND_COLOR=#101522
VITE_PHASER_ACTIVE_POINTERS=3

# Local PostgreSQL database used by Docker Compose. Do not reuse these credentials in production.
POSTGRES_USER=arcade
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=mobile_arcade
POSTGRES_PORT=5432
DATABASE_URL="postgresql://arcade:choose-a-local-password@localhost:5432/mobile_arcade?schema=public"

# Server-only access-token configuration. Use a randomly generated secret outside local development.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_ISSUER=mobile-arcade
ACCESS_TOKEN_AUDIENCE=mobile-arcade-api
REFRESH_TOKEN_TTL_SECONDS=31536000
REFRESH_TOKEN_COOKIE_NAME=__Host-arcade_refresh

# Port used by the production Node server (`npm start`). Vite uses its own development port.
PORT=4173

# Google OAuth web application credentials. Register the redirect URI exactly in Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
GOOGLE_APP_URL=http://localhost:5173

# One-time initial administrator bootstrap. Set these only in the environment where the command runs.
ADMIN_NAME=Arcade Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
